body .border-gray-200,
body .border-gray-300 {
  border-color: var(--app-border) !important;
}

body .divide-slate-100 > :not([hidden]) ~ :not([hidden]),
body .divide-slate-200 > :not([hidden]) ~ :not([hidden]) {
  border-color: var(--app-border) !important;
}

/* Shadows */
body .shadow,
body .shadow-sm,
body .shadow-md,
body .shadow-lg {
  box-shadow: 0 1px 2px var(--app-shadow) !important;
}

/* Status colors */
body .bg-red-50,
body .bg-red-100 {
  background-color: var(--app-danger-bg) !important;
}

body .border-red-200,
body .border-red-300 {
  border-color: var(--app-danger-border) !important;
}

body .text-red-600,
body .text-red-700 {
  color: var(--app-danger-text) !important;
}

body .bg-emerald-50,
body .bg-emerald-100 {
  background-color: var(--app-success-bg) !important;
}

body .text-emerald-600,
body .text-emerald-700 {
  color: var(--app-success-text) !important;
}

body .bg-amber-50,
body .bg-amber-100 {
  background-color: var(--app-warning-bg) !important;
}

body .text-amber-600,
body .text-amber-700 {
  color: var(--app-warning-text) !important;
}

body.ai-chat-no-page-scroll {
  overflow: hidden !important;
  background: var(--app-bg) !important;
}

body.ai-chat-no-page-scroll app-root {
  height: 100dvh !important;
  overflow: hidden !important;
}
