:host {
  display: block;
  height: 100%;
  min-height: 0;
}

.message-list {
  height: 100%;
  min-height: 0;
  overflow-y: auto;
  padding: 28px 24px 32px;
  scrollbar-width: none;
  font-family: Arial, Helvetica, sans-serif;
}

.message-list::-webkit-scrollbar {
  width: 0;
  height: 0;
}

.chat-empty {
  display: flex;
  min-height: 100%;
  align-items: center;
  justify-content: center;
}

.chat-empty__content {
  width: min(760px, 100%);
  text-align: center;
}

.chat-empty__content h2 {
  margin: 0;
  color: var(--app-text);
  font-size: 30px;
  font-weight: 400;
}

.chat-empty__content p {
  margin: 10px 0 0;
  color: var(--app-text-muted);
  font-size: 15px;
}

.chat-suggestions {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 10px;
  margin-top: 24px;
}

.chat-suggestions button {
  border: 1px solid var(--app-border);
  border-radius: 999px;
  background: var(--app-surface);
  padding: 9px 13px;
  color: var(--app-text);
  font-size: 13px;
  font-weight: 400;
}

.chat-suggestions button:hover {
  background: var(--app-hover);
}

.message-row {
  display: flex;
  width: min(860px, 100%);
  margin: 0 auto 24px;
}

.message-row--user {
  justify-content: flex-end;
}

.message-row--assistant {
  justify-content: flex-start;
}

.message-content {
  max-width: min(760px, 100%);
}

.message-row--user .message-content {
  max-width: min(620px, 80%);
}

.message-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 7px;
  color: var(--app-text-muted);
  font-size: 12px;
}

.message-row--user .message-meta {
  justify-content: flex-end;
}

.message-bubble {
  border-radius: 18px;
  padding: 14px 16px;
}

.message-row--assistant .message-bubble {
  border: 1px solid var(--app-border);
  background: var(--app-surface);
  color: var(--app-text);
}

.message-row--user .message-bubble {
  background: var(--app-primary);
  color: var(--app-on-primary);
}

.message-text {
  white-space: pre-wrap;
  font-size: 15px;
  font-weight: 400;
  line-height: 1.75;
}

.message-bubble--thinking {
  color: var(--app-text-muted);
  font-size: 14px;
}
