<div class="conversation-panel">
  <div class="conversation-actions">
    <button
      type="button"
      class="conversation-new"
      (click)="newChat.emit()"
    >
      + New Chat
    </button>
  </div>

  <div class="conversation-section-label">
    Recent chats
  </div>

  <div *ngIf="isLoading && !conversations.length" class="conversation-empty">
    Loading conversations...
  </div>

  <div *ngIf="!isLoading && !conversations.length" class="conversation-empty">
    No conversations yet.
  </div>

  <div *ngIf="conversations.length" class="conversation-list">
    <button
      type="button"
      *ngFor="let conversation of conversations"
      (click)="selectConversation(conversation.uuid)"
      class="conversation-item"
      [class.conversation-item--active]="conversation.uuid === activeConversationUuid"
    >
      <div class="conversation-item__title">
        {{ conversation.title }}
      </div>

      <div class="conversation-item__date">
        {{ conversation.updated_at | date: 'medium' }}
      </div>
    </button>
  </div>
</div>
