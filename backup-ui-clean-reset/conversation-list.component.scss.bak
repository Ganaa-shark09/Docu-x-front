:host {
  display: block;
  height: 100%;
  min-height: 0;
}

.conversation-panel {
  display: grid;
  height: 100%;
  min-height: 0;
  grid-template-rows: auto auto minmax(0, 1fr);
}

.conversation-actions {
  padding: 8px 10px;
}

.conversation-new {
  width: 100%;
  border: 1px solid var(--app-border);
  border-radius: 10px;
  background: var(--app-surface);
  color: var(--app-text);
  padding: 10px 12px;
  font-size: 14px;
  text-align: left;
}

.conversation-new:hover {
  background: var(--app-hover);
}

.conversation-label {
  padding: 4px 12px 8px;
  color: var(--app-text-muted);
  font-size: 12px;
}

.conversation-empty {
  padding: 10px 12px;
  color: var(--app-text-muted);
  font-size: 13px;
}

.conversation-list {
  min-height: 0;
  overflow-y: auto;
  padding: 0 8px 10px;
  scrollbar-width: none;
}

.conversation-list::-webkit-scrollbar {
  width: 0;
  height: 0;
}

.conversation-item {
  display: block;
  width: 100%;
  border: 1px solid transparent;
  border-radius: 10px;
  background: transparent;
  padding: 8px 10px;
  text-align: left;
}

.conversation-item + .conversation-item {
  margin-top: 3px;
}

.conversation-item:hover {
  background: var(--app-hover);
}

.conversation-item--active {
  border-color: var(--app-border);
  background: var(--app-surface);
}

.conversation-title {
  display: -webkit-box;
  overflow: hidden;
  color: var(--app-text);
  font-size: 13px;
  line-height: 1.35;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.conversation-date {
  margin-top: 4px;
  color: var(--app-text-muted);
  font-size: 11px;
}
