import { NgClass, NgFor, NgIf } from '@angular/common';
import {
  ChangeDetectorRef,
  Component,
  ElementRef,
  HostListener,
  NgZone,
  OnDestroy,
  ViewChild,
  inject,
} from '@angular/core';
import { FormsModule } from '@angular/forms';
import { ActivatedRoute, Router } from '@angular/router';
import { Subscription } from 'rxjs';

import {
  AiConversation,
  AiConversationMessage,
  ExternalAiChatRequest,
  ExternalDocument,
  LocalChatAttachment,
  LocalChatMessage,
} from '../../models/ai-chat.model';
import { AiChatService } from '../../services/ai-chat.service';
import {
  DocumentProcessingEvent,
  DocumentRealtimeService,
} from '../../../../core/realtime/document-realtime.service';
import { ChatMessageListComponent } from '../../components/chat-message-list/chat-message-list.component';
import { ConversationListComponent } from '../../components/conversation-list/conversation-list.component';

interface PendingExternalFile {
  id: string;
  file: File;
  name: string;
  size: number;
  extension: string;
}

@Component({
  selector: 'app-external-ai-chat-page',
  standalone: true,
  imports: [
    ChatMessageListComponent,
    ConversationListComponent,
    FormsModule,
    NgClass,
    NgFor,
    NgIf,
  ],
  templateUrl: './external-ai-chat-page.component.html',
  styleUrl: './external-ai-chat-page.component.scss',
})
export class ExternalAiChatPageComponent implements OnDestroy {
  private readonly aiChatService = inject(AiChatService);
  private readonly documentRealtimeService =
    inject(DocumentRealtimeService);
  private readonly cdr = inject(ChangeDetectorRef);
  private readonly ngZone = inject(NgZone);
  private readonly route = inject(ActivatedRoute);
  private readonly router = inject(Router);

  @ViewChild(ChatMessageListComponent) private messageList?: ChatMessageListComponent;
  @ViewChild('fileInput') private fileInput?: ElementRef<HTMLInputElement>;

  externalConversations: AiConversation[] = [];
  externalMessages: LocalChatMessage[] = [];
  externalAttachedDocuments: ExternalDocument[] = [];
  pendingFiles: PendingExternalFile[] = [];

  activeExternalConversationUuid: string | null = null;
  selectedExternalDocumentUuids = new Set<string>();

  isLoadingConversations = false;
  isLoadingConversation = false;
  isLoadingDocuments = false;
  isUploading = false;
  isSending = false;
  isDragOver = false;
  documentsPanelOpen = false;
  isSwitchingToInternal = false;

  messageText = '';
  errorMessage = '';

  private documentPollingHandle: number | null = null;

  private readonly documentPollingDelays = [
    2000,
    3000,
    5000,
    8000,
    10000,
  ];
  private conversationLoadRequestId = 0;
  private routeSubscription?: Subscription;
  private realtimeSubscription?: Subscription;

  private pendingRealtimeSend: {
    message: string;
    scopeUuids: string[];
    waitUuids: string[];
  } | null = null;

  private realtimeFallbackHandle:
    number | null = null;

  private readonly allowedExtensions = [
    'pdf',
    'docx',
    'xlsx',
    'txt',
    'csv',
    'png',
    'jpg',
    'jpeg',
    'webp',
    'bmp',
    'tiff',
    'tif',
  ];

  constructor() {
    document.body.classList.add('ai-chat-no-page-scroll');

    this.bindDocumentRealtimeEvents();

    this.routeSubscription = this.route.paramMap.subscribe((params) => {
      const uuid = params.get('conversationUuid');

      if (uuid && uuid !== this.activeExternalConversationUuid) {
        this.selectExternalConversation(uuid, false);
      }
    });

    window.setTimeout(() => this.loadExternalConversations(), 180);
  }

  ngOnDestroy(): void {
    this.realtimeSubscription?.unsubscribe();
    this.clearPendingRealtimeSend();
    this.documentRealtimeService.disconnect();
    document.body.classList.remove('ai-chat-no-page-scroll');
    this.routeSubscription?.unsubscribe();
    this.stopDocumentPolling();
  }

  @HostListener('window:dragover', ['$event'])
  preventWindowDragOver(event: DragEvent): void {
    event.preventDefault();
    event.stopPropagation();
  }

  @HostListener('window:drop', ['$event'])
  preventWindowDrop(event: DragEvent): void {
    event.preventDefault();
    event.stopPropagation();
  }

  openInternalAi(): void {
    this.isSwitchingToInternal = true;
    this.cdr.markForCheck();

    window.setTimeout(() => {
      this.router.navigate(['/ai/internal']);
    }, 180);
  }

  exitChat(): void {
    document.body.classList.remove('docux-ai-exit-closing');
    document.body.classList.add('docux-ai-route-closing');

    window.setTimeout(() => {
      this.router.navigate(['/dashboard']);
    }, 80);

    window.setTimeout(() => {
      document.body.classList.remove('docux-ai-route-closing');
    }, 1400);
  }

  startNewChat(): void {
    this.conversationLoadRequestId += 1;
    this.activeExternalConversationUuid = null;
    this.externalMessages = [];
    this.externalAttachedDocuments = [];
    this.pendingFiles = [];
    this.selectedExternalDocumentUuids.clear();
    this.errorMessage = '';
    this.documentsPanelOpen = false;
    this.isLoadingConversation = false;
    this.stopDocumentPolling();
    this.clearPendingRealtimeSend();
    this.documentRealtimeService.reset();

    this.router.navigate(['/ai/external']);
    this.cdr.markForCheck();
  }

  toggleDocumentsPanel(): void {
    this.documentsPanelOpen = !this.documentsPanelOpen;
    this.cdr.markForCheck();
  }

  loadExternalConversations(): void {
    this.isLoadingConversations = true;
    this.cdr.markForCheck();

    this.aiChatService.listConversations('external').subscribe({
      next: (conversations: AiConversation[]) => {
        this.ngZone.run(() => {
          this.externalConversations = conversations;
          this.isLoadingConversations = false;
          this.cdr.detectChanges();
        });
      },
      error: (error: unknown) => {
        this.ngZone.run(() => {
          console.error('External conversations load error:', error);
          this.externalConversations = [];
          this.isLoadingConversations = false;
          this.cdr.detectChanges();
        });
      },
    });
  }

  selectExternalConversation(uuid: string, updateUrl = true): void {
    const requestId = ++this.conversationLoadRequestId;

    if (updateUrl) {
      this.router.navigate(['/ai/external', uuid]);
    }

    this.activeExternalConversationUuid = uuid;
    this.isLoadingConversation = true;
    this.errorMessage = '';
    this.pendingFiles = [];
    this.selectedExternalDocumentUuids.clear();
    this.stopDocumentPolling();
    this.clearPendingRealtimeSend();
    this.documentRealtimeService.reset();
    this.cdr.markForCheck();

    this.aiChatService.getConversation(uuid).subscribe({
      next: (conversation: AiConversation) => {
        this.ngZone.run(() => {
          if (requestId !== this.conversationLoadRequestId) {
            return;
          }

          const rawConversation = conversation as AiConversation & {
            messages?: AiConversationMessage[];
          };

          this.externalMessages = (rawConversation.messages || [])
            .filter((message: AiConversationMessage) => message.role === 'user' || message.role === 'assistant')
            .map((message: AiConversationMessage) => this.mapConversationMessage(message));

          this.isLoadingConversation = false;
          this.cdr.detectChanges();
          this.scrollMessagesToBottom();
          this.loadAttachedDocuments();
        });
      },
      error: (error: unknown) => {
        this.ngZone.run(() => {
          if (requestId !== this.conversationLoadRequestId) {
            return;
          }

          console.error('External conversation load error:', error);
          this.externalMessages = [];
          this.isLoadingConversation = false;
          this.errorMessage = 'Unable to load messages for this conversation. Attached files will still be loaded.';
          this.cdr.detectChanges();
          this.loadAttachedDocuments();
        });
      },
    });
  }

  openUploadPicker(): void {
    this.fileInput?.nativeElement.click();
  }

  handleFileSelected(event: Event): void {
    const input = event.target as HTMLInputElement;
    this.addPendingFiles(Array.from(input.files || []));
    input.value = '';
  }

  onDragOver(event: DragEvent): void {
    event.preventDefault();
    event.stopPropagation();

    if (event.dataTransfer) {
      event.dataTransfer.dropEffect = 'copy';
    }

    this.isDragOver = true;
  }

  onDragLeave(event: DragEvent): void {
    event.preventDefault();
    event.stopPropagation();

    const target = event.currentTarget as HTMLElement;
    const relatedTarget = event.relatedTarget as Node | null;

    if (!relatedTarget || !target.contains(relatedTarget)) {
      this.isDragOver = false;
    }
  }

  onDrop(event: DragEvent): void {
    event.preventDefault();
    event.stopPropagation();

    if (event.dataTransfer) {
      event.dataTransfer.dropEffect = 'copy';
    }

    this.isDragOver = false;
    this.addPendingFiles(Array.from(event.dataTransfer?.files || []));
  }

  handlePaste(event: ClipboardEvent): void {
    const files = Array.from(event.clipboardData?.files || []);

    if (!files.length) {
      return;
    }

    event.preventDefault();
    this.addPendingFiles(files);
  }

  removePendingFile(id: string): void {
    this.pendingFiles = this.pendingFiles.filter((file) => file.id !== id);
    this.cdr.markForCheck();
  }

  sendCurrentMessage(): void {
    const message = this.messageText.trim();

    if ((!message && !this.pendingFiles.length) || this.isSending || this.isUploading) {
      return;
    }

    this.messageText = '';

    const pendingFilesSnapshot = [...this.pendingFiles];
    this.pendingFiles = [];

    this.sendMessageWithOptionalFiles(message, pendingFilesSnapshot);
  }

  handleComposerKeydown(event: KeyboardEvent): void {
    if (event.key !== 'Enter' || event.shiftKey) {
      return;
    }

    event.preventDefault();
    this.sendCurrentMessage();
  }

  loadAttachedDocuments(): void {
    if (!this.activeExternalConversationUuid) {
      this.externalAttachedDocuments = [];
      this.selectedExternalDocumentUuids.clear();
      this.stopDocumentPolling();
      this.cdr.markForCheck();
      return;
    }

    this.isLoadingDocuments = true;
    this.cdr.markForCheck();

    this.aiChatService.getExternalDocuments(this.activeExternalConversationUuid).subscribe({
      next: (documents: ExternalDocument[]) => {
        this.ngZone.run(() => {
          this.externalAttachedDocuments = documents;
          this.isLoadingDocuments = false;
          this.syncSelectedDocuments();
          this.syncMessageAttachmentsFromDocuments(documents);

          /*
           * HTTP gives authoritative initial state.
           * WebSocket supplies subsequent processing updates.
           */
          this.stopDocumentPolling();

          this.subscribeRealtimeDocuments(
            documents.map(
              (document: ExternalDocument) =>
                document.uuid,
            ),
          );

          this.cdr.detectChanges();
        });
      },
      error: (error: unknown) => {
        this.ngZone.run(() => {
          console.error('Attached documents load error:', error);
          this.isLoadingDocuments = false;
          this.errorMessage = 'Unable to load attached files.';
          this.cdr.detectChanges();
        });
      },
    });
  }

  deleteDocument(document: ExternalDocument): void {
    this.aiChatService.deleteExternalDocument(document.uuid).subscribe({
      next: () => {
        this.ngZone.run(() => {
          this.externalAttachedDocuments = this.externalAttachedDocuments.filter(
            (item: ExternalDocument) => item.uuid !== document.uuid,
          );
          this.selectedExternalDocumentUuids.delete(document.uuid);
          this.syncMessageAttachmentsFromDocuments(this.externalAttachedDocuments);
          this.cdr.detectChanges();
        });
      },
      error: () => {
        this.ngZone.run(() => {
          this.errorMessage = 'Unable to delete attached file.';
          this.cdr.detectChanges();
        });
      },
    });
  }

  toggleDocument(uuid: string): void {
    if (this.selectedExternalDocumentUuids.has(uuid)) {
      this.selectedExternalDocumentUuids.delete(uuid);
    } else {
      this.selectedExternalDocumentUuids.add(uuid);
    }

    this.cdr.markForCheck();
  }

  isDocumentSelected(uuid: string): boolean {
    return this.selectedExternalDocumentUuids.has(uuid);
  }

  getDocumentStatusLabel(document: ExternalDocument | LocalChatAttachment): string {
    const status = String(document.status || '').toLowerCase();

    if (document.processing_error || status === 'failed') {
      return 'Failed';
    }

    if (document.is_ai_ready || status === 'ready') {
      return 'Ready';
    }

    if (status === 'pending_upload') {
      return 'Uploading...';
    }

    return 'Processing...';
  }

  getDocumentStatusClass(document: ExternalDocument | LocalChatAttachment): string {
    const status = String(document.status || '').toLowerCase();

    if (document.processing_error || status === 'failed') {
      return 'external-document__status external-document__status--failed';
    }

    if (document.is_ai_ready || status === 'ready') {
      return 'external-document__status external-document__status--ready';
    }

    return 'external-document__status external-document__status--processing';
  }

  isDocumentProcessing(document: ExternalDocument | LocalChatAttachment): boolean {
    const status = String(document.status || '').toLowerCase();

    return !document.is_ai_ready &&
      status !== 'ready' &&
      !document.processing_error &&
      status !== 'failed';
  }

  get selectedDocumentCount(): number {
    return this.selectedExternalDocumentUuids.size;
  }

  formatFileSize(size: number | undefined): string {
    if (!size) {
      return '';
    }

    if (size < 1024) {
      return `${size} B`;
    }

    if (size < 1024 * 1024) {
      return `${(size / 1024).toFixed(1)} KB`;
    }

    return `${(size / (1024 * 1024)).toFixed(1)} MB`;
  }

  private addPendingFiles(files: File[]): void {
    if (!files.length) {
      return;
    }

    const validFiles = this.validateFiles(files);

    if (!validFiles.length) {
      return;
    }

    const existingKeys = new Set(
      this.pendingFiles.map((item: PendingExternalFile) => `${item.name}-${item.size}-${item.file.lastModified}`),
    );

    const newPendingFiles = validFiles
      .filter((file: File) => !existingKeys.has(`${file.name}-${file.size}-${file.lastModified}`))
      .map((file: File) => ({
        id: `${file.name}-${file.size}-${file.lastModified}-${Date.now()}-${Math.random()}`,
        file,
        name: file.name,
        size: file.size,
        extension: file.name.split('.').pop()?.toLowerCase() || '',
      }));

    this.pendingFiles = [...this.pendingFiles, ...newPendingFiles];
    this.errorMessage = '';
    this.cdr.markForCheck();
  }

  private validateFiles(files: File[]): File[] {
    const validFiles: File[] = [];
    const invalidFiles: string[] = [];

    files.forEach((file: File) => {
      const extension = file.name.split('.').pop()?.toLowerCase() || '';

      if (this.allowedExtensions.includes(extension)) {
        validFiles.push(file);
      } else {
        invalidFiles.push(file.name);
      }
    });

    if (invalidFiles.length) {
      this.errorMessage = `Unsupported file type: ${invalidFiles.join(', ')}`;
      this.cdr.markForCheck();
    }

    return validFiles;
  }

  private sendMessageWithOptionalFiles(
    message: string,
    filesToUpload: PendingExternalFile[],
  ): void {
    const userMessage: LocalChatMessage = {
      role: 'user',
      content: message,
      created_at: new Date().toISOString(),
      attachments: filesToUpload.map((file: PendingExternalFile) => ({
        local_id: file.id,
        title: file.name,
        original_filename: file.name,
        file_size: file.size,
        status: 'pending_upload',
        is_ai_ready: false,
      })),
    };

    this.externalMessages = [...this.externalMessages, userMessage];
    this.isSending = true;
    this.errorMessage = '';
    this.cdr.markForCheck();
    this.scrollMessagesToBottom();

    if (filesToUpload.length) {
      this.uploadPendingFilesThenSendMessage(
        filesToUpload,
        message,
        this.externalMessages.length - 1,
      );
      return;
    }

    this.sendExternalMessage(message);
  }

  private uploadPendingFilesThenSendMessage(
    pendingFiles: PendingExternalFile[],
    message: string,
    messageIndex: number,
  ): void {
    const formData = new FormData();

    if (this.activeExternalConversationUuid) {
      formData.append('conversation_uuid', this.activeExternalConversationUuid);
    }

    formData.append('document_type', 'other');
    formData.append('sensitivity_label', 'internal');

    pendingFiles.forEach((pendingFile: PendingExternalFile) => {
      formData.append('files', pendingFile.file);
    });

    this.isUploading = true;
    this.documentsPanelOpen = true;
    this.cdr.markForCheck();

    this.aiChatService.bulkUploadExternalDocuments(formData).subscribe({
      next: (response: { conversation_uuid: string; documents?: ExternalDocument[] }) => {
        this.ngZone.run(() => {
          if (response.conversation_uuid) {
            this.activeExternalConversationUuid = response.conversation_uuid;
            this.router.navigate(
              ['/ai/external', response.conversation_uuid],
              { replaceUrl: true },
            );
          }
          this.mergeAttachedDocuments(response.documents || []);
          this.replaceMessageAttachments(
            messageIndex,
            response.documents || [],
          );

          /*
           * Keep query + attachment as ONE user prompt.
           * Replacing attachment objects must never erase
           * the message text.
           */
          this.externalMessages =
            this.externalMessages.map(
              (
                item: LocalChatMessage,
                index: number,
              ) =>
                index === messageIndex
                  ? {
                      ...item,
                      content: message,
                    }
                  : item,
            );

          this.isUploading = false;
          this.cdr.detectChanges();

          this.loadExternalConversations();

          const uploadedDocuments = response.documents || [];
          const uploadedDocumentUuids = uploadedDocuments
            .map((document: ExternalDocument) => document.uuid)
            .filter(Boolean);

          /*
           * Freeze the COMPLETE document scope for this query.
           *
           * Existing explicit selection:
           *   selected + newly uploaded
           *
           * Nothing selected:
           *   all conversation documents
           *   including newly uploaded files
           */
          const queryDocumentUuids =
            this.resolveExternalDocumentUuids(
              uploadedDocumentUuids,
            );

          /*
           * Upload succeeded but no UUID means we cannot safely
           * bind this message to its current attachments.
           *
           * Never silently fall back to all conversation docs.
           */
          if (
            pendingFiles.length > 0 &&
            uploadedDocumentUuids.length === 0
          ) {
            this.isUploading = false;
            this.isSending = false;
            this.errorMessage =
              'The files were uploaded, but the backend did not return document UUIDs. The AI request was not sent.';
            this.cdr.detectChanges();
            return;
          }

          const failedUploads = uploadedDocuments.filter(
            (document: ExternalDocument) =>
              this.isExternalDocumentFailed(document),
          );

          if (failedUploads.length > 0) {
            this.isSending = false;
            this.errorMessage =
              failedUploads[0].processing_error ||
              'One or more uploaded files failed during processing.';
            this.cdr.detectChanges();
            return;
          }

          const pendingDocumentUuids =
            this.getPendingExternalDocumentUuids(
              uploadedDocuments,
            );

          /*
           * Subscribe immediately after upload.
           * Backend sends a current-state snapshot, so an
           * event emitted before subscription is not lost.
           */
          this.subscribeRealtimeDocuments(
            uploadedDocumentUuids,
          );

          if (
            pendingDocumentUuids.length > 0
          ) {
            if (message) {
              this.queueRealtimeSend(
                message,
                queryDocumentUuids,
                pendingDocumentUuids,
              );
            } else {
              this.isSending = false;
              this.cdr.detectChanges();
            }

            return;
          }

          if (message) {
            this.sendExternalMessage(
              message,
              queryDocumentUuids,
            );
          } else {
            this.isSending = false;
            this.cdr.detectChanges();
          }
        });
      },
      error: (error: any) => {
        this.ngZone.run(() => {
          console.error('External bulk upload error:', error);
          this.errorMessage =
            error?.error?.detail ||
            error?.error?.files?.[0] ||
            'Unable to upload files.';

          this.markMessageAttachmentsFailed(messageIndex, this.errorMessage);
          this.isUploading = false;
          this.isSending = false;
          this.cdr.detectChanges();
        });
      },
    });
  }

  private normalizeExternalDocumentUuids(
    documentUuids: string[],
  ): string[] {
    return Array.from(
      new Set(
        documentUuids
          .map((uuid: string) =>
            String(uuid || '').trim(),
          )
          .filter(Boolean),
      ),
    );
  }

  private getAllExternalConversationDocumentUuids(): string[] {
    const documentListUuids =
      this.externalAttachedDocuments
        .map(
          (document: ExternalDocument) =>
            document.uuid,
        )
        .filter(Boolean);

    const messageAttachmentUuids =
      this.externalMessages.flatMap(
        (message: LocalChatMessage) =>
          (message.attachments || [])
            .map(
              (attachment: LocalChatAttachment) =>
                attachment.uuid || '',
            )
            .filter(Boolean),
      );

    return this.normalizeExternalDocumentUuids([
      ...documentListUuids,
      ...messageAttachmentUuids,
    ]);
  }

  private resolveExternalDocumentUuids(
    currentMessageDocumentUuids: string[] = [],
  ): string[] {
    const uploadedUuids =
      this.normalizeExternalDocumentUuids(
        currentMessageDocumentUuids,
      );

    const selectedUuids =
      this.normalizeExternalDocumentUuids(
        Array.from(
          this.selectedExternalDocumentUuids,
        ),
      );

    /*
     * Explicit selection:
     *
     * selected existing documents
     * +
     * anything uploaded with THIS prompt
     */
    if (selectedUuids.length > 0) {
      return this.normalizeExternalDocumentUuids([
        ...selectedUuids,
        ...uploadedUuids,
      ]);
    }

    /*
     * Nothing selected:
     *
     * ALL documents belonging to the conversation
     * +
     * anything uploaded with THIS prompt.
     */
    return this.normalizeExternalDocumentUuids([
      ...this.getAllExternalConversationDocumentUuids(),
      ...uploadedUuids,
    ]);
  }

  private resolveExternalDocumentUuids(
    currentMessageDocumentUuids: string[] = [],
  ): string[] {
    const uploadedUuids =
      this.normalizeExternalDocumentUuids(
        currentMessageDocumentUuids,
      );

    const selectedUuids =
      this.normalizeExternalDocumentUuids(
        Array.from(
          this.selectedExternalDocumentUuids,
        ),
      );

    /*
     * Explicit selection exists.
     *
     * Query scope =
     * selected existing documents
     * +
     * files attached to THIS message.
     */
    if (selectedUuids.length > 0) {
      return this.normalizeExternalDocumentUuids([
        ...selectedUuids,
        ...uploadedUuids,
      ]);
    }

    /*
     * Nothing selected.
     *
     * Query scope = EVERY document currently
     * attached to this conversation.
     *
     * mergeAttachedDocuments() runs before this
     * during upload, so newly uploaded documents
     * are already included here.
     */
    return this.normalizeExternalDocumentUuids([
      ...this.externalAttachedDocuments.map(
        (document: ExternalDocument) =>
          document.uuid,
      ),
      ...uploadedUuids,
    ]);
  }

  private sendExternalMessage(
    message: string,
    explicitDocumentUuids?: string[],
  ): void {
    if (!message) {
      this.isSending = false;
      this.cdr.markForCheck();
      return;
    }

    /*
     * Freeze the effective scope for THIS request.
     *
     * Explicit current-message files take precedence over
     * selected conversation files.
     */
    const effectiveDocumentUuids =
      explicitDocumentUuids !== undefined
        ? this.normalizeExternalDocumentUuids(
            explicitDocumentUuids,
          )
        : this.resolveExternalDocumentUuids();

    const payload: ExternalAiChatRequest = {
      message,
      use_web: true,
      top_k: 8,

      /*
       * External AI contract:
       *
       * Always send document_uuids.
       *
       * selected docs -> selected UUIDs
       * no selection  -> all conversation UUIDs
       * no documents  -> []
       */
      document_uuids:
        effectiveDocumentUuids,
    };

    if (this.activeExternalConversationUuid) {
      payload.conversation_uuid =
        this.activeExternalConversationUuid;
    }

    console.debug(
      '[External AI] sending query scope',
      {
        conversation_uuid:
          payload.conversation_uuid,
        document_uuids:
          payload.document_uuids,
        message:
          payload.message,
      },
    );

    this.aiChatService
      .sendExternalChatMessage(payload)
      .subscribe({
        next: (response: any) => {
          this.ngZone.run(() => {
            /*
             * Backend safety layer.
             *
             * Preserve exactly the same document scope while
             * waiting. Do not re-read sidebar selection because
             * the user may change it while processing occurs.
             */
            if (
              response?.status ===
              'attachments_processing'
            ) {
              const retryAfterMs = Math.max(
                Number(
                  response.retry_after_ms || 3000,
                ),
                1000,
              );

              const backendPendingUuids =
                Array.isArray(
                  response.pending_document_uuids,
                )
                  ? response.pending_document_uuids
                  : [];

              const uuidsToPoll =
                backendPendingUuids.length
                  ? backendPendingUuids
                  : effectiveDocumentUuids || [];

              if (!uuidsToPoll.length) {
                this.isSending = false;
                this.errorMessage =
                  'Attachments are still processing, but no document UUID was returned for status tracking.';
                this.cdr.detectChanges();
                return;
              }

              /*
               * Backend confirmed that one or more documents
               * required by this query are still processing.
               *
               * Do NOT poll processing-status here.
               * Subscribe/wait for WebSocket readiness instead.
               */
              this.queueRealtimeSend(
                message,
                effectiveDocumentUuids,
                uuidsToPoll,
              );

              return;
            }

            /*
             * Never render processing/non-answer responses as
             * empty assistant messages.
             */
            if (
              typeof response?.answer !== 'string'
            ) {
              this.isSending = false;
              this.errorMessage =
                response?.detail ||
                'External AI returned an unexpected response.';
              this.cdr.detectChanges();
              return;
            }

            if (response.conversation_uuid) {
              this.activeExternalConversationUuid =
                response.conversation_uuid;

              this.router.navigate(
                [
                  '/ai/external',
                  response.conversation_uuid,
                ],
                {
                  replaceUrl: true,
                },
              );
            }

            const assistantMessage: LocalChatMessage = {
              role: 'assistant',
              content: response.answer,
              created_at: new Date().toISOString(),
              sources: response.sources || [],
              model_provider: response.model_provider,
              model_name: response.model_name,
              usage: response.usage,
              external_context:
                response.external_context,
            };

            this.appendAssistantMessageWithFastTyping(
              assistantMessage,
            );

            this.loadExternalConversations();

            /*
             * IMPORTANT:
             * Do NOT call loadAttachedDocuments() here.
             *
             * Sending/receiving a chat answer does not require
             * reloading the whole attachment list.
             */
          });
        },

        error: (error: any) => {
          this.ngZone.run(() => {
            console.error(
              'External AI chat error:',
              error,
            );

            this.errorMessage =
              error?.error?.detail ||
              'Unable to send external AI message.';

            this.isSending = false;
            this.cdr.detectChanges();
          });
        },
      });
  }

  private bindDocumentRealtimeEvents(): void {
    this.realtimeSubscription =
      this.documentRealtimeService
        .events$
        .subscribe(
          (
            event:
              DocumentProcessingEvent,
          ) => {
            if (
              event.event !==
                'document.processing.snapshot' &&
              event.event !==
                'document.processing.updated'
            ) {
              return;
            }

            if (!event.document_uuid) {
              return;
            }

            this.applyDocumentRealtimeEvent(
              event,
            );

            /*
             * Any realtime activity proves the socket is alive.
             * Push fallback polling further out.
             */
            this.scheduleRealtimeFallback();

            this.tryFlushPendingRealtimeSend();

            this.cdr.detectChanges();
          },
        );
  }

  private subscribeRealtimeDocuments(
    documentUuids: string[],
  ): void {
    const normalized =
      this.normalizeExternalDocumentUuids(
        documentUuids,
      );

    if (!normalized.length) {
      return;
    }

    this.documentRealtimeService
      .subscribeDocuments(normalized);
  }

  private applyDocumentRealtimeEvent(
    event: DocumentProcessingEvent,
  ): void {
    const uuid = event.document_uuid;

    if (!uuid) {
      return;
    }

    this.externalAttachedDocuments =
      this.externalAttachedDocuments.map(
        (
          document: ExternalDocument,
        ) => {
          if (document.uuid !== uuid) {
            return document;
          }

          return {
            ...document,

            status:
              event.status ??
              document.status,

            is_ai_ready:
              typeof event.is_ai_ready ===
              'boolean'
                ? event.is_ai_ready
                : document.is_ai_ready,

            processing_error:
              event.error ??
              document.processing_error,
          };
        },
      );

    /*
     * Update the attachment card inside the
     * already-visible user prompt too.
     */
    this.externalMessages =
      this.externalMessages.map(
        (
          message: LocalChatMessage,
        ) => ({
          ...message,

          attachments:
            (
              message.attachments || []
            ).map(
              (
                attachment:
                  LocalChatAttachment,
              ) => {
                if (
                  attachment.uuid !== uuid
                ) {
                  return attachment;
                }

                return {
                  ...attachment,

                  status:
                    event.status ??
                    attachment.status,

                  is_ai_ready:
                    typeof event
                      .is_ai_ready ===
                    'boolean'
                      ? event
                          .is_ai_ready
                      : attachment
                          .is_ai_ready,

                  processing_error:
                    event.error ??
                    attachment
                      .processing_error,
                };
              },
            ),
        }),
      );
  }

  private queueRealtimeSend(
    message: string,
    scopeUuids: string[],
    waitUuids: string[],
  ): void {
    this.stopDocumentPolling();

    this.pendingRealtimeSend = {
      message,
      scopeUuids:
        this.normalizeExternalDocumentUuids(
          scopeUuids,
        ),
      waitUuids:
        this.normalizeExternalDocumentUuids(
          waitUuids,
        ),
    };

    this.subscribeRealtimeDocuments(
      waitUuids,
    );

    this.scheduleRealtimeFallback();

    this.tryFlushPendingRealtimeSend();
  }

  private tryFlushPendingRealtimeSend(): void {
    const pending =
      this.pendingRealtimeSend;

    if (!pending) {
      return;
    }

    const documentsByUuid =
      new Map<string, ExternalDocument>(
        this.externalAttachedDocuments.map(
          (
            document:
              ExternalDocument,
          ) => [
            document.uuid,
            document,
          ],
        ),
      );

    const targetDocuments =
      pending.waitUuids
        .map(
          (uuid: string) =>
            documentsByUuid.get(uuid),
        )
        .filter(
          (
            document:
              ExternalDocument | undefined,
          ): document is ExternalDocument =>
            !!document,
        );

    /*
     * Wait for snapshot/event for every UUID.
     */
    if (
      targetDocuments.length !==
      pending.waitUuids.length
    ) {
      return;
    }

    const failed =
      targetDocuments.find(
        (
          document:
            ExternalDocument,
        ) =>
          this.isExternalDocumentFailed(
            document,
          ),
      );

    if (failed) {
      this.isSending = false;

      this.errorMessage =
        failed.processing_error ||
        'An attachment failed during processing.';

      this.clearPendingRealtimeSend();
      return;
    }

    const allReady =
      targetDocuments.every(
        (
          document:
            ExternalDocument,
        ) =>
          !this.getPendingExternalDocumentUuids(
            [document],
          ).length,
      );

    if (!allReady) {
      return;
    }

    /*
     * Capture before clearing.
     */
    const message =
      pending.message;

    const scopeUuids =
      [...pending.scopeUuids];

    this.clearPendingRealtimeSend();

    /*
     * Now send the original query with the
     * exact frozen UUID scope.
     */
    this.sendExternalMessage(
      message,
      scopeUuids,
    );
  }

  private scheduleRealtimeFallback(): void {
    if (!this.pendingRealtimeSend) {
      return;
    }

    if (this.realtimeFallbackHandle !== null) {
      window.clearTimeout(
        this.realtimeFallbackHandle,
      );
    }

    this.realtimeFallbackHandle =
      window.setTimeout(() => {
        this.realtimeFallbackHandle = null;

        const pending =
          this.pendingRealtimeSend;

        if (!pending) {
          return;
        }

        /*
         * Do NOT fall back to continuous HTTP status polling.
         *
         * Re-subscription causes the backend to send a fresh
         * document.processing.snapshot from authoritative DB state.
         */
        if (this.documentRealtimeService.isConnected) {
          console.debug(
            '[DocuX realtime] Re-subscribing pending documents:',
            pending.waitUuids,
          );
        } else {
          console.warn(
            '[DocuX realtime] Socket is not ready. Reconnecting:',
            pending.waitUuids,
          );
        }

        this.subscribeRealtimeDocuments(
          pending.waitUuids,
        );
      }, 12000);
  }

  private clearPendingRealtimeSend(): void {
    this.pendingRealtimeSend = null;

    if (
      this.realtimeFallbackHandle !==
      null
    ) {
      window.clearTimeout(
        this.realtimeFallbackHandle,
      );

      this.realtimeFallbackHandle =
        null;
    }

    this.stopDocumentPolling();
  }

  private appendAssistantMessageWithFastTyping(message: LocalChatMessage): void {
    const fullContent = message.content || '';

    if (!fullContent) {
      this.externalMessages = [...this.externalMessages, message];
      this.isSending = false;
      this.cdr.detectChanges();
      this.scrollMessagesToBottom();
      return;
    }

    const messageIndex = this.externalMessages.length;

    const typingMessage: LocalChatMessage = {
      ...message,
      content: '',
    };

    this.externalMessages = [...this.externalMessages, typingMessage];
    this.isSending = false;
    this.cdr.detectChanges();
    this.scrollMessagesToBottom();

    const plan = this.getTypingPlan(fullContent.length);
    let cursor = 0;

    const tick = (): void => {
      cursor = Math.min(cursor + plan.chunkSize, fullContent.length);

      this.externalMessages = this.externalMessages.map((item: LocalChatMessage, index: number) => {
        if (index !== messageIndex) {
          return item;
        }

        return {
          ...item,
          content: fullContent.slice(0, cursor),
        };
      });

      this.cdr.detectChanges();
      this.scrollMessagesToBottom();

      if (cursor < fullContent.length) {
        window.setTimeout(tick, plan.delayMs);
      }
    };

    tick();
  }

  private getTypingPlan(length: number): { chunkSize: number; delayMs: number } {
    if (length <= 180) {
      return { chunkSize: 18, delayMs: 10 };
    }

    if (length <= 800) {
      return { chunkSize: 45, delayMs: 8 };
    }

    if (length <= 2400) {
      return { chunkSize: 100, delayMs: 5 };
    }

    return { chunkSize: 180, delayMs: 3 };
  }

  private replaceMessageAttachments(
    messageIndex: number,
    documents: ExternalDocument[],
  ): void {
    this.externalMessages = this.externalMessages.map((message: LocalChatMessage, index: number) => {
      if (index !== messageIndex) {
        return message;
      }

      return {
        ...message,
        attachments: documents.map((document: ExternalDocument) => this.mapDocumentToAttachment(document)),
      };
    });
  }

  private markMessageAttachmentsFailed(messageIndex: number, reason: string): void {
    this.externalMessages = this.externalMessages.map((message: LocalChatMessage, index: number) => {
      if (index !== messageIndex) {
        return message;
      }

      return {
        ...message,
        attachments: (message.attachments || []).map((attachment: LocalChatAttachment) => ({
          ...attachment,
          status: 'failed',
          processing_error: reason,
        })),
      };
    });
  }

  private syncMessageAttachmentsFromDocuments(documents: ExternalDocument[]): void {
    const documentsByUuid = new Map<string, ExternalDocument>(
      documents.map((document: ExternalDocument) => [document.uuid, document]),
    );

    this.externalMessages = this.externalMessages
      .map((message: LocalChatMessage) => {
        if (/^Uploaded\s+\d+\s+file/i.test(message.content || '') && !message.attachments?.length) {
          return {
            ...message,
            content: '',
          };
        }

        if (!message.attachments?.length) {
          return message;
        }

        return {
          ...message,
          attachments: message.attachments.map((attachment: LocalChatAttachment) => {
            if (attachment.uuid && documentsByUuid.has(attachment.uuid)) {
              return this.mapDocumentToAttachment(documentsByUuid.get(attachment.uuid)!);
            }

            const attachmentName =
              attachment.original_filename ||
              attachment.filename ||
              attachment.title;

            const matchedDocument = documents.find((document: ExternalDocument) => {
              const documentName =
                document.original_filename ||
                document.filename ||
                document.title;

              return documentName === attachmentName;
            });

            return matchedDocument
              ? this.mapDocumentToAttachment(matchedDocument)
              : attachment;
          }),
        };
      })
      .filter((message: LocalChatMessage) => {
        return !!message.content || !!message.attachments?.length || message.role === 'assistant';
      });

    const existingAttachmentUuids = new Set<string>();

    this.externalMessages.forEach((message: LocalChatMessage) => {
      (message.attachments || []).forEach((attachment: LocalChatAttachment) => {
        if (attachment.uuid) {
          existingAttachmentUuids.add(attachment.uuid);
        }
      });
    });

    const missingDocumentMessages: LocalChatMessage[] = documents
      .filter((document: ExternalDocument) => !existingAttachmentUuids.has(document.uuid))
      .map((document: ExternalDocument) => ({
        role: 'user',
        content: '',
        created_at: document.created_at || new Date().toISOString(),
        attachments: [this.mapDocumentToAttachment(document)],
      }));

    if (missingDocumentMessages.length) {
      this.externalMessages = [...this.externalMessages, ...missingDocumentMessages].sort(
        (a: LocalChatMessage, b: LocalChatMessage) =>
          new Date(a.created_at).getTime() - new Date(b.created_at).getTime(),
      );
    }
  }

  private mapDocumentToAttachment(document: ExternalDocument): LocalChatAttachment {
    const status = String(document.status || '').toLowerCase();

    return {
      uuid: document.uuid,
      title: document.title,
      original_filename: document.original_filename,
      filename: document.filename,
      file_size: document.file_size,
      status: document.status,
      is_ai_ready: !!document.is_ai_ready || status === 'ready',
      processing_error: document.processing_error,
    };
  }

  private mergeAttachedDocuments(documents: ExternalDocument[]): void {
    const existing = new Map<string, ExternalDocument>(
      this.externalAttachedDocuments.map((document: ExternalDocument) => [document.uuid, document]),
    );

    documents.forEach((document: ExternalDocument) => {
      existing.set(document.uuid, document);
    });

    this.externalAttachedDocuments = Array.from(existing.values());
  }

  private startDocumentPolling(
    documentUuids?: string[],
    onReady?: () => void,
    initialDelayMs?: number,
  ): void {
    this.stopDocumentPolling();

    const targetDocumentUuids = Array.from(
      new Set(
        (
          documentUuids?.length
            ? documentUuids
            : this.getPendingExternalDocumentUuids(
                this.externalAttachedDocuments,
              )
        ).filter(Boolean),
      ),
    );

    if (!targetDocumentUuids.length) {
      onReady?.();
      return;
    }

    this.scheduleDocumentProcessingCheck(
      targetDocumentUuids,
      onReady,
      0,
      initialDelayMs,
    );
  }

  private scheduleDocumentProcessingCheck(
    documentUuids: string[],
    onReady: (() => void) | undefined,
    attempt: number,
    overrideDelayMs?: number,
  ): void {
    if (!documentUuids.length) {
      this.stopDocumentPolling();
      onReady?.();
      return;
    }

    const delay =
      overrideDelayMs ??
      this.documentPollingDelays[
        Math.min(
          attempt,
          this.documentPollingDelays.length - 1,
        )
      ];

    this.documentPollingHandle = window.setTimeout(() => {
      this.documentPollingHandle = null;

      this.pollExternalDocumentProcessingStatus(
        documentUuids,
        onReady,
        attempt,
      );
    }, delay);
  }

  private pollExternalDocumentProcessingStatus(
    documentUuids: string[],
    onReady: (() => void) | undefined,
    attempt: number,
  ): void {
    if (!documentUuids.length) {
      this.stopDocumentPolling();
      onReady?.();
      return;
    }

    this.aiChatService
      .getExternalDocumentProcessingStatus(
        documentUuids,
        this.activeExternalConversationUuid || undefined,
      )
      .subscribe({
        next: (response: any) => {
          this.ngZone.run(() => {
            const statusDocuments =
              response?.documents || [];

            this.applyExternalDocumentProcessingStatuses(
              statusDocuments,
            );

            const failedDocuments =
              statusDocuments.filter((document: any) =>
                this.isExternalDocumentFailed(document),
              );

            if (
              response?.has_failed ||
              failedDocuments.length > 0
            ) {
              this.stopDocumentPolling();

              this.isSending = false;
              this.isUploading = false;

              this.errorMessage =
                failedDocuments[0]?.processing_error ||
                'One or more attached files failed during processing.';

              this.cdr.detectChanges();
              return;
            }

            const remainingPendingUuids =
              statusDocuments
                .filter(
                  (document: any) =>
                    !this.isExternalDocumentReady(document) &&
                    !this.isExternalDocumentFailed(document),
                )
                .map((document: any) => document.uuid)
                .filter(Boolean);

            if (
              response?.all_ready ||
              remainingPendingUuids.length === 0
            ) {
              this.stopDocumentPolling();
              this.cdr.detectChanges();

              onReady?.();
              return;
            }

            this.cdr.detectChanges();

            this.scheduleDocumentProcessingCheck(
              remainingPendingUuids,
              onReady,
              attempt + 1,
            );
          });
        },

        error: (error: unknown) => {
          this.ngZone.run(() => {
            console.error(
              'External attachment processing-status error:',
              error,
            );

            this.scheduleDocumentProcessingCheck(
              documentUuids,
              onReady,
              attempt + 1,
            );
          });
        },
      });
  }

  private stopDocumentPolling(): void {
    if (this.documentPollingHandle !== null) {
      window.clearTimeout(this.documentPollingHandle);
      this.documentPollingHandle = null;
    }
  }

  private getPendingExternalDocumentUuids(
    documents: ExternalDocument[],
  ): string[] {
    return documents
      .filter(
        (document: ExternalDocument) =>
          !this.isExternalDocumentReady(document) &&
          !this.isExternalDocumentFailed(document),
      )
      .map((document: ExternalDocument) => document.uuid)
      .filter(Boolean);
  }

  private isExternalDocumentReady(
    document: Partial<ExternalDocument>,
  ): boolean {
    const status = String(
      document.status || '',
    ).toLowerCase();

    return (
      document.is_ai_ready === true ||
      status === 'ready'
    );
  }

  private isExternalDocumentFailed(
    document: Partial<ExternalDocument>,
  ): boolean {
    const status = String(
      document.status || '',
    ).toLowerCase();

    return (
      status === 'failed' ||
      !!document.processing_error
    );
  }

  private applyExternalDocumentProcessingStatuses(
    statusDocuments: any[],
  ): void {
    if (!statusDocuments.length) {
      return;
    }

    const statusByUuid = new Map<string, any>(
      statusDocuments.map((document: any) => [
        document.uuid,
        document,
      ]),
    );

    this.externalAttachedDocuments =
      this.externalAttachedDocuments.map(
        (document: ExternalDocument) => {
          const latest = statusByUuid.get(document.uuid);

          if (!latest) {
            return document;
          }

          return {
            ...document,
            status:
              latest.status ??
              document.status,
            is_ai_ready:
              typeof latest.is_ai_ready === 'boolean'
                ? latest.is_ai_ready
                : document.is_ai_ready,
            processing_error:
              latest.processing_error ??
              document.processing_error,
          };
        },
      );

    this.externalMessages =
      this.externalMessages.map(
        (message: LocalChatMessage) => ({
          ...message,
          attachments: (message.attachments || []).map(
            (attachment: LocalChatAttachment) => {
              if (!attachment.uuid) {
                return attachment;
              }

              const latest =
                statusByUuid.get(attachment.uuid);

              if (!latest) {
                return attachment;
              }

              return {
                ...attachment,
                status:
                  latest.status ??
                  attachment.status,
                is_ai_ready:
                  typeof latest.is_ai_ready === 'boolean'
                    ? latest.is_ai_ready
                    : attachment.is_ai_ready,
                processing_error:
                  latest.processing_error ??
                  attachment.processing_error,
              };
            },
          ),
        }),
      );
  }

  private syncSelectedDocuments(): void {
    const availableUuids = new Set<string>(
      this.externalAttachedDocuments.map((document: ExternalDocument) => document.uuid),
    );

    Array.from(this.selectedExternalDocumentUuids).forEach((uuid: string) => {
      if (!availableUuids.has(uuid)) {
        this.selectedExternalDocumentUuids.delete(uuid);
      }
    });
  }

  private scrollMessagesToBottom(): void {
    window.setTimeout(() => this.messageList?.scrollToBottom(), 0);
  }

  private mapConversationMessage(message: AiConversationMessage): LocalChatMessage {
    const raw = message as any;

    return {
      role: message.role === 'assistant' ? 'assistant' : 'user',
      content: /^Uploaded\s+\d+\s+file/i.test(message.content || '') ? '' : message.content,
      created_at: message.created_at,
      sources: raw.retrieved_sources || raw.sources || [],
      model_provider: raw.model_provider,
      model_name: raw.model_name,
      usage: {
        prompt_tokens: raw.prompt_tokens || 0,
        completion_tokens: raw.completion_tokens || 0,
        total_tokens: raw.total_tokens || 0,
      },
      external_context: raw.metadata?.external_context,
    };
  }
}
